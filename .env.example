# Firebase Configuration for Kings Building Materials Business System
# Copy this file to .env and replace with your project values from the Firebase Console (https://console.firebase.google.com/)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=blessed-kings-enterprises.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=blessed-kings-enterprises
VITE_FIREBASE_STORAGE_BUCKET=blessed-kings-enterprises.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# The build-time sitemap generator reads VITE_FIREBASE_API_KEY and
# VITE_FIREBASE_PROJECT_ID to list public products and categories.
# If they are unavailable, the build deploys the static sitemap fallback.
